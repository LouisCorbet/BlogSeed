# =====================================================================
# Variables d'environnement MINIMALES
# Seules ces variables vivent dans le .env — tout le reste (Google OAuth,
# SMTP, Analytics, AdSense...) est configurable depuis l'admin (table Setting).
# =====================================================================

# ----- Base de données -----
POSTGRES_USER=blog
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=blog
# URL utilisée par Prisma (doit correspondre aux valeurs ci-dessus)
DATABASE_URL="postgresql://blog:change_me_strong_password@db:5432/blog?schema=public"

# ----- Next-Auth -----
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=change_me_with_openssl_rand
NEXTAUTH_URL=https://mon-domaine.fr

# ----- Domaine (utilisé par Caddy) -----
DOMAIN=mon-domaine.fr
